rules_version = '2';

// כללי אבטחה ל-Firestore של רדאר AI.
// להדביק ב-Firebase Console → Firestore Database → Rules → Publish.
//
// עקרונות: כולם קוראים, רק מחוברים כותבים, וכל אחד יכול למחוק רק את מה שהוא כתב.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return signedIn() && data.uid == request.auth.uid;
    }

    // תגובות: comments/{autoId}
    // { slug, itemId, uid, name, photo, text, createdAt }
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data)
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.slug is string
        && request.resource.data.itemId is string
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner(resource.data);
      allow update: if false;
    }

    // לייקים: likes/{slug}_{itemId}_{uid}
    // { slug, itemId, uid, createdAt }
    match /likes/{likeId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data)
        && likeId == request.resource.data.slug + '_' + request.resource.data.itemId + '_' + request.auth.uid;
      allow delete: if isOwner(resource.data);
      allow update: if false;
    }
  }
}
